__pycache__/
*.pyc

# L2 / market data: raw archives and converted parquet never enter git
data/raw/**/*.zip
data/raw/**/*.csv
data/raw/**/*.json
data/processed/**/*.parquet
data/processed/**/*.csv
data/processed/**/*.json

# exception: the curated macro timeline is small metadata, version it
!data/macro_timeline.csv

.pytest_cache/
.ipynb_checkpoints/

# Library weight policy (roadmap_to_endpoint.md improvement 3):
# extracted texts and indexes are versioned; NEW raw PDFs are not.
# The 186 already-tracked PDFs stay tracked; everything new lands
# in data/library_pdfs/ and stays local to the codespace.
data/library_pdfs/
logs/*.log

# compound Hawkes demo output (synthetic, regenerated at will)
ofhawkes_demo_data.json
