//@version=5
// ============================================================================
// AVFI v5 "Night Before" — the AVFI v4 engine + the full computable
// night-before state panel
// ============================================================================
// WHAT THIS IS:
//   The AVFI v4 engine (flow spread throttle, stretch axis, detector
//   confirmation — every component kept for a measured reason) UNCHANGED,
//   plus the complete list of state criteria that can be computed from
//   daily OHLCV alone, measured on every bar and shown in the dashboard.
//
// WHY: the move census (1,461 episodes) and the night-before gallery (92
//   panels) found that no chart contains the move it precedes — it contains
//   the STATE. This panel computes that state live: the trader sees the
//   same six numbers the dossier captions carry (range position, vol
//   percentile, coil days, stretch z, volume dry-up, year trend) plus the
//   Tier-B derivatives (quiet-spell age, contraction rate, drawdown from
//   peak, time since last significant move, prior-move magnitude).
//
// WHAT IT IS NOT — read this part:
//   The night-before panel is DESCRIPTIVE. A census counts, it does not
//   predict; the composite signature below has NOT passed the dual-split
//   gate and is displayed as state, never as an entry signal. Entries
//   remain exactly what the evidence supports: deep stretch + detector
//   confirmation (v4). The throttle remains a sizing regime, not a timer.
//   Multiplicity binds; C7 sealed.
//
// STRICT CAUSALITY: every window is trailing; signals finalize on bar
// close (barstate.isconfirmed). Criteria formulas match
// paper/research/night_before_criteria.md (appendix) exactly.
// ============================================================================

indicator("AVFI v5 — Night Before", shorttitle="AVFI v5",
          overlay=true, max_labels_count=500)

// ---------------------------------------------------------------------------
// INPUTS
// ---------------------------------------------------------------------------
// Flow engine (unchanged from v4)
flowLen   = input.int(20,     "Volume normalization window", minval=5,  group="Flow engine")
pkLen     = input.int(10,     "sigmaPk range-vol window",     minval=5,  group="Flow engine")
emaSlow   = input.int(13,     "Slow EMA of v2 (spread axis)", minval=5,  group="Flow engine")
spZLen    = input.int(100,    "Spread z-score window",        minval=20, group="Flow engine")
trigger   = input.float(-1.5, "Throttle trigger (spread z)",  step=0.1,  group="Flow engine")
useThr    = input.bool(true,  "Show throttle zones",                     group="Flow engine")

// Stretch + confirmation (unchanged from v4)
pzLen     = input.int(100,    "Price z-score window",          minval=20, group="Stretch + confirmation")
deepZ     = input.float(-2.0, "Deep stretch threshold (z)",    step=0.25, group="Stretch + confirmation")
useDiv    = input.bool(true,  "RSI divergence confirmation",              group="Stretch + confirmation")
useClimax = input.bool(true,  "VSA climax confirmation",                  group="Stretch + confirmation")
rsiLen    = input.int(14,     "RSI length",                    minval=2,  group="Stretch + confirmation")
divLb     = input.int(5,      "Divergence pivot lookback",     minval=2,  group="Stretch + confirmation")

// Night-before panel (the registry defaults; see criteria appendix)
nbRangeW  = input.int(252, "Range window (A1/A6/B3/B7)", minval=60, group="Night-before panel")
nbRvW     = input.int(20,  "Realized-vol window (A2)",   minval=5,  group="Night-before panel")
nbRvPctW  = input.int(252, "Vol-percentile window (A2)", minval=60, group="Night-before panel")
nbQuietP  = input.float(30, "Quiet vol percentile (B2)",  step=5,    group="Night-before panel")
nbRngW    = input.int(50,  "Range-average window (A3)",  minval=20, group="Night-before panel")
nbCoilF   = input.float(0.75, "Coil range fraction (A3)", step=0.05, group="Night-before panel")
nbVolW    = input.int(20,  "Volume window (A5)",         minval=5,  group="Night-before panel")
nbFastW   = input.int(10,  "Fast window (B5/B6/B8)",      minval=5,  group="Night-before panel")
nbSlowW   = input.int(50,  "Slow window (B5/B6/B8)",     minval=20, group="Night-before panel")
nbMoveTh  = input.float(30.0, "Last-move threshold % (B1)", step=5,   group="Night-before panel") / 100.0
showSig   = input.bool(true, "Show composite signature marker",       group="Night-before panel")

// ---------------------------------------------------------------------------
// 1. THE FLOW ENGINE — AVFI v3 vs slow AVFI v2 (unchanged, validated)
// ---------------------------------------------------------------------------
rngSq    = math.log(high / low) ** 2
pkConst  = 1.0 / (4.0 * math.log(2.0))
sigmaPk  = math.sqrt(ta.sma(rngSq, pkLen) * pkConst)

lv       = math.log(math.max(volume, 1.0))
volAvg   = ta.sma(lv, flowLen)
va       = volAvg > 0 ? lv / volAvg : 1.0

sgnRet   = ta.change(close)
avfiV3   = sgnRet * va * sigmaPk

volAvgS  = ta.sma(volume, flowLen)
ratio    = volAvgS > 0 ? volume / volAvgS : 1.0
avfiV2   = sgnRet * ratio
v2Slow   = ta.ema(avfiV2, emaSlow)

spread   = avfiV3 - v2Slow
spMean   = ta.sma(spread, spZLen)
spSd     = ta.stdev(spread, spZLen)
spZ      = spSd > 0 ? (spread - spMean) / spSd : 0.0
throttled = useThr and spZ <= trigger

// ---------------------------------------------------------------------------
// 2. THE STRETCH AXIS (unchanged, validated)
// ---------------------------------------------------------------------------
logP     = math.log(close)
pMean    = ta.sma(logP, pzLen)
pSd      = ta.stdev(logP, pzLen)
priceZ   = pSd > 0 ? (logP - pMean) / pSd : 0.0

// ---------------------------------------------------------------------------
// 3. DETECTOR CONFIRMATION (unchanged, validated)
// ---------------------------------------------------------------------------
rsiVal = ta.rsi(close, rsiLen)

pLo = ta.pivotlow(low,  divLb, divLb)
pHi = ta.pivothigh(high, divLb, divLb)
var float lastPLoPrice = na
var float lastPLoRsi   = na
var float lastPHiPrice = na
var float lastPHiRsi   = na
bullDivNow = false
bearDivNow = false
if not na(pLo)
    curRsi = rsiVal[divLb]
    if not na(lastPLoPrice) and low[divLb] < lastPLoPrice and curRsi > lastPLoRsi and curRsi < 40
        bullDivNow := true
    lastPLoPrice := low[divLb]
    lastPLoRsi   := curRsi
if not na(pHi)
    curRsi = rsiVal[divLb]
    if not na(lastPHiPrice) and high[divLb] > lastPHiPrice and curRsi < lastPHiRsi and curRsi > 60
        bearDivNow := true
    lastPHiPrice := high[divLb]
    lastPHiRsi   := curRsi

volNorm   = ta.sma(volume, flowLen)
rangeNorm = ta.sma(high - low, flowLen)
wideBar   = (high - low) >= 1.5 * rangeNorm
hugeVol   = volume >= 2.0 * volNorm
upHalf    = (close - low) / math.max(high - low, syminfo.mintick) >= 0.5
dnHalf    = (high - close) / math.max(high - low, syminfo.mintick) >= 0.5
decline   = close[1] < close[10]
rally     = close[1] > close[10]
climaxBottom = hugeVol and wideBar and decline and upHalf
climaxTop    = hugeVol and wideBar and rally   and dnHalf

confBull = (useDiv and (bullDivNow or climaxBottom or
            bullDivNow[1] or climaxBottom[1] or
            bullDivNow[2] or climaxBottom[2] or
            bullDivNow[3] or climaxBottom[3])) or
           (useClimax and (climaxBottom or climaxBottom[1] or
            climaxBottom[2] or climaxBottom[3]))
confBear = (useDiv and (bearDivNow or climaxTop or
            bearDivNow[1] or climaxTop[1] or
            bearDivNow[2] or climaxTop[2] or
            bearDivNow[3] or climaxTop[3])) or
           (useClimax and (climaxTop or climaxTop[1] or
            climaxTop[2] or climaxTop[3]))

confirmedBottom = priceZ <= deepZ and confBull
confirmedTop    = priceZ >= -deepZ and confBear
sigBottom = barstate.isconfirmed and confirmedBottom
sigTop    = barstate.isconfirmed and confirmedTop

// ---------------------------------------------------------------------------
// 4. THE NIGHT-BEFORE PANEL — every computable criterion, live
// ---------------------------------------------------------------------------
// Formulas match paper/research/night_before_criteria.md (appendix).

// A1 — range position in the yearly range
hiW = ta.highest(high, nbRangeW)
loW = ta.lowest(low,  nbRangeW)
rangePos = hiW > loW ? (close - loW) / (hiW - loW) : 0.5

// A2 — realized-vol percentile (0-100) of current vol vs trailing year
rv      = ta.stdev(math.log(close / close[1]), nbRvW)
rvPct   = ta.percentrank(rv, nbRvPctW)

// A3 — coil days: consecutive bars with range <= fraction of its average
rngAvg  = ta.sma(high - low, nbRngW)
coilDay = rngAvg > 0 and (high - low) <= nbCoilF * rngAvg
var int coilDays = 0
coilDays := coilDay ? coilDays + 1 : 0

// A4 — stretch z (same as priceZ above; the panel shows it as state)
// A5 — volume ratio (the dry-up reading is < 1)
volRatio = volNorm > 0 ? volume / volNorm : 1.0

// A6 — year trend
trend52 = close[nbRangeW] > 0 ? close / close[nbRangeW] - 1.0 : 0.0

// B1 — time since last significant 30-day move
ret30 = close[30] > 0 ? close / close[30] - 1.0 : 0.0
bigMove = math.abs(ret30) >= nbMoveTh
var int lastMoveBar = na
if bigMove and barstate.isconfirmed
    lastMoveBar := bar_index
timeSinceMove = na(lastMoveBar) ? na : bar_index - lastMoveBar

// B2 — consecutive quiet days (spell AGE, not just spell depth)
quietDay = rvPct <= nbQuietP
var int quietDays = 0
quietDays := quietDay ? quietDays + 1 : 0

// B3 — time from the 52w high
var int lastHighBar = na
if high >= hiW and barstate.isconfirmed
    lastHighBar := bar_index
timeFromHigh = na(lastHighBar) ? na : bar_index - lastHighBar

// B5 — contraction rate (< 1 means the coil is tightening)
rngFast = ta.sma(high - low, nbFastW)
contrRate = rngAvg > 0 ? rngFast / rngAvg : 1.0

// B6 — ATR ratio
atrFast = ta.atr(nbFastW)
atrSlow = ta.atr(nbSlowW)
atrRatio = atrSlow > 0 ? atrFast / atrSlow : 1.0

// B7 — drawdown from the 52w peak (the numeric grievance)
ddPeak = hiW > 0 ? close / hiW - 1.0 : 0.0

// B8 — volume-trend direction (is the dry-up getting drier?)
volFast = ta.sma(volume, nbFastW)
volTrend = volNorm > 0 ? volFast / volNorm : 1.0

// B9 — prior-move magnitude: largest |30d return| in the trailing year
priorMax = 0.0
for i = 30 to nbRangeW
    r = close[i] > 0 ? math.abs(close / close[i] - 1.0) : 0.0
    if r > priorMax
        priorMax := r
priorMovePct = priorMax * 100.0

// The composite forgotten-and-pinned signature — DESCRIPTIVE state only.
// A census counts, it does not predict; this has NOT passed any gate.
signature = rangePos <= 0.25 and rvPct <= nbQuietP and coilDays >= 10 and
            volRatio < 1.0 and trend52 < 0.0

// ---------------------------------------------------------------------------
// RENDERING
// ---------------------------------------------------------------------------
bgcolor(throttled ? color.new(#f85149, 88) : na)
bgcolor(showSig and signature and barstate.isconfirmed ?
        color.new(#a371f7, 92) : na, title="Composite signature (state, NOT a signal)")

plotshape(sigBottom, title="Confirmed bottom (stretch + confirmation)",
          style=shape.labelup, location=location.belowbar,
          color=color.new(#3fb950, 20), textcolor=color.white,
          text="B", size=size.tiny)
plotshape(sigTop, title="Confirmed top (stretch + confirmation)",
          style=shape.labeldown, location=location.abovebar,
          color=color.new(#f85149, 20), textcolor=color.white,
          text="S", size=size.tiny)
plotshape(bullDivNow, title="RSI divergence bottom",
          style=shape.triangleup, location=location.belowbar,
          color=color.new(#3fb950, 55), size=size.tiny)
plotshape(bearDivNow, title="RSI divergence top",
          style=shape.triangledown, location=location.abovebar,
          color=color.new(#f85149, 55), size=size.tiny)
plotshape(climaxBottom, title="VSA climax bottom",
          style=shape.square, location=location.belowbar,
          color=color.new(#3fb950, 55), size=size.tiny)
plotshape(climaxTop, title="VSA climax top",
          style=shape.square, location=location.abovebar,
          color=color.new(#f85149, 55), size=size.tiny)

// ---------------------------------------------------------------------------
// DASHBOARD — the complete night-before panel, as the dossier captions read
// ---------------------------------------------------------------------------
f_row(t, r, name, val, isHot, hotCol) =>
    table.cell(t, 0, r, name, text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, r, val,
               text_color=isHot ? hotCol : color.white, text_size=size.small)

var table t = table.new(position.top_right, 2, 16, border_width=1)
if barstate.islast
    table.cell(t, 0, 0, "AVFI v5", bgcolor=color.new(#161b22, 10),
               text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, "night-before state", bgcolor=color.new(#161b22, 10),
               text_color=color.gray, text_size=size.tiny)
    f_row(t, 1,  "A1 range pos",   str.tostring(rangePos, "#.##"),
          rangePos <= 0.25, #3fb950)
    f_row(t, 2,  "A2 vol pct",     str.tostring(rvPct, "#") + "%",
          rvPct <= nbQuietP, #3fb950)
    f_row(t, 3,  "A3 coil days",   str.tostring(coilDays),
          coilDays >= 10, #3fb950)
    f_row(t, 4,  "A4 stretch z",   str.tostring(priceZ, "#.##"),
          priceZ <= deepZ, #3fb950)
    f_row(t, 5,  "A5 vol ratio",   str.tostring(volRatio, "#.##"),
          volRatio < 1.0, #3fb950)
    f_row(t, 6,  "A6 year trend",  str.tostring(trend52 * 100, "#.#") + "%",
          trend52 < 0, #f85149)
    f_row(t, 7,  "B1 since move",  na(timeSinceMove) ? "—" : str.tostring(timeSinceMove) + "d",
          not na(timeSinceMove) and timeSinceMove >= 90, #a371f7)
    f_row(t, 8,  "B2 quiet days",   str.tostring(quietDays),
          quietDays >= 10, #3fb950)
    f_row(t, 9,  "B3 from 52w hi",  na(timeFromHigh) ? "—" : str.tostring(timeFromHigh) + "d",
          not na(timeFromHigh) and timeFromHigh >= 90, #a371f7)
    f_row(t, 10, "B5 contraction",  str.tostring(contrRate, "#.##"),
          contrRate < 1.0, #3fb950)
    f_row(t, 11, "B6 atr ratio",    str.tostring(atrRatio, "#.##"),
          atrRatio < 1.0, #3fb950)
    f_row(t, 12, "B7 drawdown",     str.tostring(ddPeak * 100, "#.#") + "%",
          ddPeak <= -0.5, #f85149)
    f_row(t, 13, "B8 vol trend",    str.tostring(volTrend, "#.##"),
          volTrend < 1.0, #3fb950)
    f_row(t, 14, "B9 prior move",  str.tostring(priorMovePct, "#") + "%",
          priorMovePct >= 100.0, #a371f7)
    table.cell(t, 0, 15, "signature", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 15, signature ? "pinned (STATE, not a signal)" : "—",
               text_color=signature ? #a371f7 : color.gray, text_size=size.tiny)

// ---------------------------------------------------------------------------
// ALERTS
// ---------------------------------------------------------------------------
alertcondition(sigBottom, "AVFI v5 confirmed bottom",
              "AVFI v5: deep stretch confirmed by detector — bottom signal")
alertcondition(sigTop, "AVFI v5 confirmed top",
              "AVFI v5: deep stretch confirmed by detector — top signal")
alertcondition(showSig and signature and not signature[1], "AVFI v5 composite signature ON",
              "AVFI v5: forgotten-and-pinned state present — descriptive, not an entry signal")
alertcondition(throttled and not throttled[1], "AVFI v5 throttle ON",
              "AVFI v5: spread z below trigger — regime risk-off")
